# =========================================================================
# Przykladowy plik konfiguracyjny z kluczami API.
# Skopiuj go do pliku ".env" (cp .env.example .env) i uzupelnij swoimi kluczami.
# Plik .env NIE jest wysylany do repozytorium (jest w .gitignore).
# =========================================================================

# Klucz do modelu jezykowego (OpenAI). Wymagany do dzialania chatbota i agenta.
# Mozna go zdobyc na https://platform.openai.com/api-keys
OPENAI_API_KEY=

# (opcjonalnie) Nazwa modelu jezykowego. Domyslnie: gpt-4o-mini
OPENAI_MODEL=gpt-4o-mini

# (opcjonalnie) Adres serwera zgodnego z API OpenAI.
# Zostaw puste, aby uzywac oficjalnego OpenAI. Mozna podac np. lokalny serwer.
OPENAI_BASE_URL=

# Klucz do SerpAPI (wyszukiwanie w Google). Wymagany do pobierania informacji z internetu.
# Mozna go zdobyc na https://serpapi.com/manage-api-key
SERPAPI_API_KEY=
